# No keys required for the labelled, rule-based demo mode.
# Gemini is preferred when configured; the key stays on the server.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_STT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Aoede
# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=nova
# Set a long random secret before public deployment. Signs per-call demo order state.
SESSION_SECRET=
